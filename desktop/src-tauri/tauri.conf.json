{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OrchestrAI",
  "mainBinaryName": "orchestrai-desktop",
  "version": "0.23.0",
  "identifier": "tools.orchestrai.desktop",
  "build": {
    "beforeDevCommand": "bun scripts/stage-sidecar.mjs --profile debug --no-target && bun --cwd ../desktop-next run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "bun scripts/stage-sidecar.mjs --profile release && bun --cwd ../desktop-next run build",
    "frontendDist": "../../desktop-next/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "OrchestrAI",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "backgroundColor": "#171717",
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* ws://localhost:*",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/orchestrai"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
