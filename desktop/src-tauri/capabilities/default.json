{
  "$schema": "https://raw.githubusercontent.com/nicholasgriffintn/tauri-plugin-dialog/v2/capabilities/schema.json",
  "identifier": "default",
  "description": "Default capabilities for the OrchestrAI desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "opener:default",
    "process:allow-restart"
  ]
}
