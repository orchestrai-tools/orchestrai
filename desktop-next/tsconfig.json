{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@warpforge/protocol": ["../packages/protocol/src/index.ts"],
      "@warpforge/daemon": ["../packages/daemon/src/index.ts"],
      "@warpforge/daemon/*": ["../packages/daemon/src/*"],
      "@warpforge/core/*": ["../packages/core/src/*"],
      "@warpforge/ui/*": ["../packages/ui/src/*"]
    }
  },
  "include": ["src"]
}
